# EduGenie Environment Variables

# ---- Frontend ----
# Backend API URL (the Python FastAPI server)
VITE_API_BASE_URL=http://localhost:8000

# Supabase (pre-configured — do not change unless you know what you're doing)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Backend (copy backend/.env.example to backend/.env) ----
# Google Gemini API Key — get one free at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
# ALLOWED_ORIGINS=*
