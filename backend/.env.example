# EduGenie Backend Environment Variables
# Copy this file to ".env" in the same directory and fill in your values.

# Google Gemini API Key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: change the Gemini model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Optional: restrict CORS origins (comma-separated, default: * allows all)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
